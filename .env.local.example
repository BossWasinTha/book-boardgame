# Copy this file to .env.local and fill in real values.
# Get the Supabase values from Project Settings → API in your Supabase project.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxx

# Any long random string — used to sign member/admin session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=xxxxxxxxxxxx

# 6-digit PIN for the /admin dashboard.
ADMIN_PIN=426842
